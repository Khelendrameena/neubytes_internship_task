# Copy this file to .env for local development. .env is git-ignored — never commit it.
# This project doesn't call any paid/external API, so there's no real secret to set.
# PORT and FLASK_DEBUG are here to show the pattern: anything environment-specific or
# sensitive (API keys, DB URLs, tokens) belongs here, not hardcoded in app.py.

PORT=5000
FLASK_DEBUG=false
